# Pies Planos - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED
# ============================================

# Anthropic API Key for Claude AI
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================
# OPTIONAL
# ============================================

# OpenAI API Key (fallback/alternative AI)
# Get yours at: https://platform.openai.com/
# OPENAI_API_KEY=sk-your-key-here

# Logging Level
# Options: DEBUG | INFO | WARNING | ERROR | NONE
# - DEBUG: Full debug output (development)
# - INFO: API calls and info messages (default)
# - WARNING: Warnings and errors only
# - ERROR: Errors only
# - NONE: No logging (cleanest gameplay)
LOG_LEVEL=INFO

# For clean gameplay experience, use:
# LOG_LEVEL=NONE

TELEGRAM_TOKEN=your_bot_token_here
DB_HOST=localhost
DB_PORT=3306
DB_USER=piesplanos_bot
DB_PASSWORD=your_password_here
DB_NAME=piesplanos
